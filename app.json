{
  "expo": {
    "name": "Pokéfolio",
    "slug": "pokefolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pokefolio-icon.png",
    "scheme": "pokefolio",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/pokefolio-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#285440",
        "foregroundImage": "./assets/images/pokefolio-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/pokefolio-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#285440",
          "image": "./assets/images/pokefolio-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "A little curiosity. A world of Pokémon. Discover, explore, and build your dream team.",
    "backgroundColor": "#F8F8F2"
  }
}
